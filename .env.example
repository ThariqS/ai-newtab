# Only needed for the Node/Bun harness in harness/. The extension asks for credentials in its UI.

# Claude engine: an Anthropic API key.
ANTHROPIC_API_KEY=
# OpenAI engine: either sign in with `pnpm agent:login` (ChatGPT plan; tokens land in
# harness/.siwc-credentials.json) or set an API key here.
OPENAI_API_KEY=
# OpenAI model slug (see `pnpm agent:models`). Default: the first model the credentials list.
OPENAI_MODEL=
# Force an engine when both credentials exist: claude | openai
HOMEPAGE_ENGINE=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=
